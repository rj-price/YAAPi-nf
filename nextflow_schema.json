{
    "\$schema": "http://json-schema.org/draft-07/schema",
    "\$id": "https://raw.githubusercontent.com/jnprice/YAAPi-nf/master/nextflow_schema.json",
    "title": "YAAPi-nf pipeline parameters",
    "description": "Yeast Assembly and Annotation Pipeline",
    "type": "object",
    "definitions": {
        "input_output_options": {
            "title": "Input/output options",
            "type": "object",
            "fa_icon": "fas fa-terminal",
            "description": "Define where the pipeline should find input data and save output results.",
            "required": ["reads"],
            "properties": {
                "reads": {
                    "type": "string",
                    "format": "file-path",
                    "mimetype": "text/fastq",
                    "pattern": "^\S+.*{1,2}\.(fastq|fq)(\.gz)?$",
                    "description": "Path to input reads (must be quoted)",
                    "help_text": "Path to your input reads. Use a glob pattern with brackets for paired-end data, e.g., '/path/to/data/*{1,2}.fastq.gz'",
                    "fa_icon": "fas fa-file-import"
                },
                "outdir": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "The output directory",
                    "default": "./results",
                    "fa_icon": "fas fa-folder-open"
                }
            }
        },
        "database_options": {
            "title": "Database options",
            "type": "object",
            "description": "Paths to various databases required by the pipeline.",
            "properties": {
                "busco_db": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "Path to BUSCO database"
                },
                "kraken2_db": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "Path to Kraken2 database"
                },
                "mito_db": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "Path to Organelle BLAST database"
                }
            }
        },
        "tool_options": {
            "title": "Tool parameters",
            "type": "object",
            "description": "Tune specific tool settings.",
            "properties": {
                "busco_lineage": {
                    "type": "string",
                    "default": "fungi_odb10",
                    "description": "BUSCO lineage to use"
                },
                "kmer_length": {
                    "type": "integer",
                    "default": 21,
                    "description": "K-mer length for analysis"
                },
                "ploidy": {
                    "type": "integer",
                    "default": 2,
                    "description": "Expected ploidy for GenomeScope2"
                }
            }
        }
    },
    "allOf": [
        { "\$ref": "#/definitions/input_output_options" },
        { "\$ref": "#/definitions/database_options" },
        { "\$ref": "#/definitions/tool_options" }
    ]
}
